# Build output
bin/
obj/
artifacts/

# IDE state
.vs/
.vscode/
.idea/
*.user
*.suo

# Local portable-mode data created while developing
TackData/

# Sync clients' scratch folders (e.g. Google Drive)
.tmp.driveupload/

# Python cache from tools/
__pycache__/

# Claude Code's local settings and worktrees
.claude/

# Local environment files (never commit secrets); an example file may be committed
.env
.env.*
!.env.example

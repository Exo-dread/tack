# Cloudflare Pages response headers. Built into dist/_headers by vite.config.ts, which fills in
# the hash of the one inline script (the theme boot script in index.html).
#
# Tack Focus makes no network requests of its own: everything is same-origin, and the CSP says so.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' '__BOOT_SCRIPT_HASH__'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000

# Fingerprinted build output never changes: cache it forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app shell and service worker must always be revalidated, or updates would be missed.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json

/icons/*
  Cache-Control: public, max-age=604800

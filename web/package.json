{
  "name": "tack-focus",
  "version": "0.2.1",
  "private": true,
  "description": "Tack Focus: Tack's tasks and notes as an offline-first web app for phones, tablets and browsers.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "vectors": "vitest run tests/unit/vectors.test.ts tests/unit/syncvectors.test.ts --update",
    "e2e": "playwright test",
    "icons": "python tools/make_icons.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "fake-indexeddb": "6.2.6",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}

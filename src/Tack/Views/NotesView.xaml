<UserControl x:Class="Tack.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tack.Controls"
             xmlns:v="clr-namespace:Tack.Views">
    <UserControl.Resources>
        <c:BoolToVisibility x:Key="Vis" />

        <!-- Sheet pills -->
        <Style x:Key="SheetPill" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,4" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Move to" lists the spaces when the menu opens (and shows only once there are spaces). -->
        <ContextMenu x:Key="SheetMenu" x:Shared="False" Opened="SheetMenu_Opened">
            <MenuItem Header="Move to" Tag="MoveTo" Visibility="Collapsed" />
            <MenuItem Header="Delete sheet" Click="DeleteSheet_Click" />
        </ContextMenu>

        <!-- A snippet's thumbnail: the image (set as its background) in a rounded frame. Click (or Enter) to view
             it, Delete discards it, Shift+F10 its menu. The strip is one tab stop, ← → between thumbnails. -->
        <Style x:Key="SnippetThumb" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource StrokeStrongBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The × over a thumbnail's corner, shown while the pointer is over the thumbnail. -->
        <Style x:Key="SnippetDiscard" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Content" Value="&#xE711;" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" BorderThickness="1" Background="{DynamicResource FlyoutBrush}"
                                BorderBrush="{DynamicResource StrokeStrongBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="SnippetMenu" x:Shared="False">
            <MenuItem Header="View" Click="ViewSnippet_Click" />
            <MenuItem Header="Discard snippet" Click="DiscardSnippet_Click" />
        </ContextMenu>

        <!-- The paper itself. -->
        <Style x:Key="NotesBox" TargetType="TextBox" BasedOn="{StaticResource GhostTextBox}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="14,12,14,12" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A checkbox in a formatted note: a small rounded square, filled with the accent and ticked when done. -->
        <Style x:Key="NoteCheck" TargetType="CheckBox">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1.5" Background="Transparent"
                                BorderBrush="{DynamicResource TextTertiaryBrush}">
                            <!-- A path, not a glyph: nothing for a screen reader to find inside the box but the box. -->
                            <Path x:Name="Tick" Data="M 1.5,5 L 4,7.5 L 8.5,2.5" Width="10" Height="10" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                  Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="ReaderMenu">
            <MenuItem Header="Edit" Click="EditMenu_Click" InputGestureText="F2" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="14,0,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sheet strip -->
        <Grid Margin="2,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="SheetList" ItemsSource="{Binding Sheets}" SelectedItem="{Binding ActiveSheet}"
                     ItemContainerStyle="{StaticResource SheetPill}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     Focusable="False" SelectionChanged="SheetList_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="SheetScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" ContextMenu="{StaticResource SheetMenu}" MaxWidth="130"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11"
                    Content="&#xE710;" Click="AddSheet_Click" ToolTip="New sheet (Ctrl+N)" AutomationProperties.Name="New sheet" />
        </Grid>

        <!-- Paper -->
        <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource ControlFillBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Snippets: images pasted onto this sheet, kept on this PC only. Not there until the sheet has one. -->
                <!-- Lined up with the text below it (the box's padding and its own inset). -->
                <ScrollViewer x:Name="SnippetScroller" Margin="16,10,16,0" Visibility="Collapsed" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="SnippetScroller_PreviewMouseWheel">
                    <StackPanel x:Name="SnippetStrip" Orientation="Horizontal" AutomationProperties.Name="Snippets"
                                KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>

                <!-- A space with no sheets shows blank paper: the first keystroke makes its sheet. -->
                <!-- MaxLength: DeviceFile.MaxNoteText, the longest note any device reads from a sync file. -->
                <TextBox x:Name="Editor" Grid.Row="1" Style="{StaticResource NotesBox}" AutomationProperties.Name="Note" MaxLength="1000000"
                         Text="{Binding ActiveSheet.Text, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="Editor_PreviewKeyDown" TextChanged="Editor_TextChanged"
                         LostKeyboardFocus="Editor_LostKeyboardFocus" />
                <!-- The note formatted (docs/NOTES-MARKDOWN.md): shown whenever the editor doesn't have the keyboard, its text
                     lined up with the editor's. A click opens the editor at that line; typing writes. Only the rows in view are made. -->
                <ScrollViewer x:Name="ReaderScroller" Grid.Row="1" Visibility="Collapsed" Focusable="False" CanContentScroll="True"
                              Padding="16,12,14,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <v:NoteReader x:Name="Reader" ContextMenu="{StaticResource ReaderMenu}"
                                  AutomationProperties.Name="Note" AutomationProperties.HelpText="Formatted. Click a line, or start typing, to edit."
                                  PreviewKeyDown="Reader_PreviewKeyDown" PreviewTextInput="Reader_PreviewTextInput"
                                  PreviewMouseLeftButtonDown="Reader_PreviewMouseLeftButtonDown" />
                </ScrollViewer>
                <TextBlock x:Name="Hint" Grid.Row="1" Margin="16,12,16,12" IsHitTestVisible="False" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}" LineHeight="20"
                           Visibility="{Binding ActiveSheet.IsEmpty, Converter={StaticResource Vis}, FallbackValue=Visible}">
                    <Run Text="Jot anything. It saves as you type." />
                    <LineBreak /><LineBreak />
                    <Run Text="Ctrl+Enter" FontWeight="SemiBold" /><Run Text="  turns a line into a task" />
                    <LineBreak />
                    <Run Text="F5" FontWeight="SemiBold" /><Run Text="  stamps the date and time" />
                    <LineBreak />
                    <Run Text="- " FontWeight="SemiBold" /><Run Text="  starts a list" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>

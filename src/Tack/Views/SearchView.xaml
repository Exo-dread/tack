<UserControl x:Class="Tack.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tack.Controls">
    <UserControl.Resources>
        <c:BoolToVisibility x:Key="Vis" />

        <!-- A line of a result, with the match picked out (the text before it, the match, the text after). -->
        <Style x:Key="Match" TargetType="Run">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <!-- The caret stays in the search box: a click opens the result, arrows there move along. -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneTime}" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Item_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="7" BorderThickness="1" Background="Transparent" BorderBrush="Transparent"
                                Padding="0,6,8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFaintBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResultTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- What it is: an open task's ring, a finished task's tick, a sheet, or More. -->
                <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0">
                    <Ellipse x:Name="Ring" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.4" Visibility="Collapsed" />
                    <Grid x:Name="Tick" Visibility="Collapsed">
                        <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.55" />
                        <Path Data="M 3.6,7.3 L 6,9.6 L 10.4,4.9" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Grid>
                    <TextBlock x:Name="Sheet" Text="&#xE70B;" Style="{StaticResource Glyph}" FontSize="13"
                               Foreground="{DynamicResource TextTertiaryBrush}" Visibility="Collapsed" />
                    <TextBlock x:Name="More" Text="&#xE712;" Style="{StaticResource Glyph}" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                </Grid>

                <TextBlock x:Name="Line" Grid.Column="1" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13">
                    <Run Text="{Binding Line.Before, Mode=OneTime}" /><Run Text="{Binding Line.Match, Mode=OneTime}" Style="{StaticResource Match}" /><Run Text="{Binding Line.After, Mode=OneTime}" />
                </TextBlock>
                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Margin="8,1,0,0" MaxWidth="96" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Top" Text="{Binding Meta, Mode=OneTime}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding HasSecond, Mode=OneTime, Converter={StaticResource Vis}}">
                    <Run Text="{Binding Second.Before, Mode=OneTime}" /><Run Text="{Binding Second.Match, Mode=OneTime}" Style="{StaticResource Match}" /><Run Text="{Binding Second.After, Mode=OneTime}" />
                </TextBlock>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="Task">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="Done">
                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="Note">
                    <Setter TargetName="Sheet" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="More">
                    <Setter TargetName="More" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Line" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Line" Property="FontSize" Value="12" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- "TASKS · 12": one heading per group, which screen readers hear as the group's name. -->
        <Style x:Key="Group" TargetType="GroupItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneTime}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <TextBlock Text="{Binding Name, Mode=OneTime}" Style="{StaticResource Overline}" Margin="8,10,0,4"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <ItemsPresenter />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,0,14,8">
        <!-- Before anything is typed, and when nothing matches. -->
        <StackPanel x:Name="Hint" Margin="4,18,4,0" VerticalAlignment="Top" IsHitTestVisible="False">
            <TextBlock x:Name="HintTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       TextAlignment="Center" />
            <TextBlock x:Name="HintText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <ListBox x:Name="Results" Background="Transparent" BorderThickness="0" Focusable="False"
                 AutomationProperties.Name="Results" ItemTemplate="{StaticResource ResultTemplate}"
                 ItemContainerStyle="{StaticResource ResultItem}" SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                 Margin="-14,0,-14,-8" Padding="14,0,14,12">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer x:Name="Scroller" Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource Group}" />
            </ListBox.GroupStyle>
        </ListBox>
    </Grid>
</UserControl>

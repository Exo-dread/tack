<UserControl x:Class="Tack.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,18,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,4" />
        </Style>
        <Style x:Key="Row" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,9" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,-6,52,10" />
        </Style>
        <Style x:Key="HotkeyPill" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,5" MinWidth="64" Background="{DynamicResource SubtleFillBrush}"
                                BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="capturing">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFaintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A space's name in Settings: reads as text, edits in place (Enter keeps it, Esc puts it back). -->
        <Style x:Key="SpaceNameBox" TargetType="TextBox" BasedOn="{StaticResource GhostTextBox}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="MaxLength" Value="100" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="5" BorderThickness="1" Background="Transparent" BorderBrush="Transparent">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}"
                                           Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillFocusBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpaceButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <!-- One option of a segmented choice (System / Light / Dark). -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="5" Padding="10,4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="14,0,14,16">

                <TextBlock Text="General" Style="{StaticResource SectionLabel}" Margin="2,4,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Start with Windows" Margin="0,9"
                                  IsChecked="{Binding Settings.LaunchAtStartup}" />
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Step aside for full-screen apps" Margin="0,9,0,8"
                                  IsChecked="{Binding Settings.HideInFullscreen}" />
                        <TextBlock Style="{StaticResource Hint}" Text="Hides the orb while a video, game or slideshow fills the screen." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Shortcut" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,9">
                            <TextBlock Text="Show or hide Tack" VerticalAlignment="Center" FontSize="13" />
                            <Button x:Name="HotkeyButton" Style="{StaticResource HotkeyPill}" HorizontalAlignment="Right"
                                    Click="HotkeyButton_Click" ToolTip="Click, then press a new shortcut. Backspace turns it off." />
                        </Grid>
                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}" Margin="0,-4,0,10" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Appearance" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,8">
                            <TextBlock Text="Theme" VerticalAlignment="Center" FontSize="13" />
                            <Border HorizontalAlignment="Right" CornerRadius="7" Padding="2" BorderThickness="1"
                                    Background="{DynamicResource SubtleFillBrush}" BorderBrush="{DynamicResource StrokeBrush}">
                                <StackPanel x:Name="ThemeChoices" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Tag="system" Content="System"
                                                 Checked="Theme_Checked" ToolTip="Follow Windows' light or dark mode" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Tag="light" Content="Light"
                                                 Checked="Theme_Checked" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Tag="dark" Content="Dark"
                                                 Checked="Theme_Checked" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <CheckBox x:Name="GlassToggle" Style="{StaticResource ToggleSwitch}" Content="Frosted glass" Margin="0,9,0,8"
                                  IsChecked="{Binding Settings.Glass}" />
                        <TextBlock x:Name="GlassHint" Style="{StaticResource Hint}" Text="Turn off for a solid, high-contrast panel." />
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,8">
                            <TextBlock Text="Accent" VerticalAlignment="Center" FontSize="13" />
                            <StackPanel x:Name="Swatches" Orientation="Horizontal" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Hint}" Margin="2,8,8,0"
                           Text="Each tab remembers its own size. Drag the panel's edges to set it; double-click the header to go back to automatic sizing." />

                <TextBlock Text="Spaces" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}" Padding="8,4,6,4">
                    <StackPanel>
                        <!-- Main, then each space: rename in place; spaces also move and go. Built in code. -->
                        <StackPanel x:Name="SpaceRows" />
                        <Border Height="1" Margin="6,0,0,0" Background="{DynamicResource DividerBrush}" />
                        <Button x:Name="NewSpaceButton" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="0,5,0,4"
                                Content="+ New space" Click="NewSpace_Click" ToolTip="Work, development, personal: keep each apart" />
                        <TextBox x:Name="NewSpaceBox" Style="{StaticResource SpaceNameBox}" Margin="0,5,0,4" Tag="Name, then Enter"
                                 Visibility="Collapsed" AutomationProperties.Name="New space name"
                                 PreviewKeyDown="NewSpaceBox_PreviewKeyDown" LostKeyboardFocus="NewSpaceBox_LostKeyboardFocus" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SpacesHint" Style="{StaticResource Hint}" Margin="2,8,8,0"
                           Text="Spaces keep work, development and personal tasks apart. Everything starts in Main; click a name to rename it. Once there's a second space, a strip under the header switches between them (Alt+1 to Alt+9, Alt+0 for All)." />

                <TextBlock Text="Sync" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}" Padding="14,10">
                    <StackPanel>
                        <TextBlock x:Name="SyncIntro" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Keep this PC in step with Tack Focus on your phone, through your own OneDrive. Tack itself never goes online: the OneDrive app carries your tasks and notes." />
                        <TextBlock x:Name="SyncStatusText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5" Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="SyncFolderText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        <WrapPanel Margin="-8,6,0,0">
                            <Button x:Name="SyncOnButton" Style="{StaticResource TextButton}" Content="Turn on sync" Click="SyncOn_Click"
                                    ToolTip="Finds Tack Focus's folder in OneDrive on this PC" />
                            <Button x:Name="SyncChooseButton" Style="{StaticResource TextButton}" Content="Choose folder…" Click="SyncChoose_Click"
                                    ToolTip="Sync through another folder, e.g. one shared with your other PCs" />
                            <Button x:Name="SyncNowButton" Style="{StaticResource TextButton}" Content="Sync now" Click="SyncNow_Click" />
                            <Button x:Name="SyncOffButton" Style="{StaticResource TextButton}" Content="Turn off" Click="SyncOff_Click"
                                    ToolTip="Stops syncing. Your tasks stay here, and the files stay in OneDrive for your other devices." />
                        </WrapPanel>
                        <TextBlock x:Name="SyncPrivacy" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="With sync on, your tasks and notes are saved in OneDrive as ordinary files: you can open them; Microsoft can read them as your storage provider, and so can apps you've given your whole OneDrive to. They aren't end-to-end encrypted yet." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Your data" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}" Padding="14,10">
                    <StackPanel>
                        <TextBlock x:Name="DataIntro" Text="Everything stays on this PC. No account, no cloud, no tracking." TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="DataPath" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="-8,6,0,0">
                            <Button Style="{StaticResource TextButton}" Content="Open data folder" Click="OpenFolder_Click" />
                            <Button Style="{StaticResource TextButton}" Content="Import…" Click="Import_Click" Margin="4,0,0,0"
                                    ToolTip="Merge a tack.json from Tack Focus, another PC or a backup" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Import adds what’s new from a Tack Focus export or another tack.json. Where both changed, the newer edit wins, and a note written in both places is kept twice." />
                    </StackPanel>
                </Border>

                <Grid Margin="2,20,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Free and open source · MIT License" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource TextButton}" HorizontalAlignment="Right" Content="Quit Tack" Click="Quit_Click"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

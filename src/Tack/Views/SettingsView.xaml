<UserControl x:Class="Tack.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,18,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,4" />
        </Style>
        <Style x:Key="Row" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,9" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,-6,52,10" />
        </Style>
        <Style x:Key="HotkeyPill" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,5" MinWidth="64" Background="{DynamicResource SubtleFillBrush}"
                                BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="capturing">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFaintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One option of a segmented choice (System / Light / Dark). -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="5" Padding="10,4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="14,0,14,16">

                <TextBlock Text="General" Style="{StaticResource SectionLabel}" Margin="2,4,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Start with Windows" Margin="0,9"
                                  IsChecked="{Binding Settings.LaunchAtStartup}" />
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Step aside for full-screen apps" Margin="0,9,0,8"
                                  IsChecked="{Binding Settings.HideInFullscreen}" />
                        <TextBlock Style="{StaticResource Hint}" Text="Hides the orb while a video, game or slideshow fills the screen." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Shortcut" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,9">
                            <TextBlock Text="Show or hide Tack" VerticalAlignment="Center" FontSize="13" />
                            <Button x:Name="HotkeyButton" Style="{StaticResource HotkeyPill}" HorizontalAlignment="Right"
                                    Click="HotkeyButton_Click" ToolTip="Click, then press a new shortcut. Backspace turns it off." />
                        </Grid>
                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}" Margin="0,-4,0,10" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Appearance" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,8">
                            <TextBlock Text="Theme" VerticalAlignment="Center" FontSize="13" />
                            <Border HorizontalAlignment="Right" CornerRadius="7" Padding="2" BorderThickness="1"
                                    Background="{DynamicResource SubtleFillBrush}" BorderBrush="{DynamicResource StrokeBrush}">
                                <StackPanel x:Name="ThemeChoices" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Tag="system" Content="System"
                                                 Checked="Theme_Checked" ToolTip="Follow Windows' light or dark mode" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Tag="light" Content="Light"
                                                 Checked="Theme_Checked" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Tag="dark" Content="Dark"
                                                 Checked="Theme_Checked" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <CheckBox x:Name="GlassToggle" Style="{StaticResource ToggleSwitch}" Content="Frosted glass" Margin="0,9,0,8"
                                  IsChecked="{Binding Settings.Glass}" />
                        <TextBlock x:Name="GlassHint" Style="{StaticResource Hint}" Text="Turn off for a solid, high-contrast panel." />
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="0,8">
                            <TextBlock Text="Accent" VerticalAlignment="Center" FontSize="13" />
                            <StackPanel x:Name="Swatches" Orientation="Horizontal" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Hint}" Margin="2,8,8,0"
                           Text="Each tab remembers its own size. Drag the panel's edges to set it; double-click the header to go back to automatic sizing." />

                <TextBlock Text="Your data" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Everything stays on this PC. No account, no cloud, no tracking." TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="DataPath" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="-8,6,0,0" Content="Open data folder"
                                Click="OpenFolder_Click" />
                    </StackPanel>
                </Border>

                <Grid Margin="2,20,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Free and open source · MIT License" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource TextButton}" HorizontalAlignment="Right" Content="Quit Tack" Click="Quit_Click"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

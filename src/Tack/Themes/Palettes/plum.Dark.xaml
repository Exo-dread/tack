<!-- Plum, dark: a dusky violet. Laid over Dark.xaml by ThemeManager: surfaces only, so text keeps the base palette's contrast. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="GlassTintBrush" Color="#851A1222" />
    <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#FF22192B" />
    <SolidColorBrush x:Key="FlyoutBrush" Color="#FA2E2438" />
</ResourceDictionary>

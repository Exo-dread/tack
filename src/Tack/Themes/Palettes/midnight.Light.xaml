<!-- Midnight, light: a cool blue-grey. Laid over Light.xaml by ThemeManager: surfaces only, so text keeps the base palette's contrast. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="GlassTintBrush" Color="#80E6EEFA" />
    <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#FFE8EFFA" />
    <SolidColorBrush x:Key="FlyoutBrush" Color="#FCF4F7FD" />
</ResourceDictionary>

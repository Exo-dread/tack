<!-- Moss, dark: a deep green-grey. Laid over Dark.xaml by ThemeManager: surfaces only, so text keeps the base palette's contrast. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="GlassTintBrush" Color="#85111A16" />
    <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#FF18211D" />
    <SolidColorBrush x:Key="FlyoutBrush" Color="#FA222D28" />
</ResourceDictionary>

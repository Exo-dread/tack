<!-- Dark palette: light text on dark glass. Swapped at runtime by ThemeManager; every key here
     must also exist in Light.xaml, and is referenced with DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#45FFFFFF" />

    <SolidColorBrush x:Key="SubtleFillBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#09FFFFFF" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="ControlFillFocusBrush" Color="#33000000" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#12FFFFFF" />

    <!-- Laid over the acrylic to keep text contrast high on busy backgrounds. -->
    <SolidColorBrush x:Key="GlassTintBrush" Color="#85141418" />
    <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#FF1F2024" />
    <SolidColorBrush x:Key="FlyoutBrush" Color="#FA2A2B30" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#80FFFFFF" />

    <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="ToggleOffFillBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="ToggleOffKnobBrush" Color="#C8FFFFFF" />

    <SolidColorBrush x:Key="BrandTrackBrush" Color="#24FFFFFF" />
</ResourceDictionary>

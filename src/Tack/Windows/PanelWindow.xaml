<Window x:Class="Tack.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Tack.Views"
        Title="Tack"
        Width="340" Height="480" MinWidth="280" MinHeight="260"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource BodySize}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextRenderingMode="Grayscale">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="5"
                      CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- Tint over the acrylic (or a solid surface when glass is off). -->
        <Border x:Name="Surface" Background="{StaticResource GlassTintBrush}" />

        <Grid x:Name="Chrome">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Header (also the drag handle) ============ -->
            <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand mark: a tiny version of the orb. -->
                <Grid Width="18" Height="18" Margin="16,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse Stroke="#24FFFFFF" StrokeThickness="1.8" />
                    <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 9,0.9 A 8.1,8.1 0 1 1 1.3,11.5" />
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" />
                </Grid>

                <StackPanel x:Name="Tabs" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TasksTab" Style="{StaticResource TabButton}" GroupName="PanelTabs" Checked="Tab_Checked"
                                 ToolTip="Tasks (Ctrl+1)" AutomationProperties.Name="Tasks">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tasks" />
                            <TextBlock x:Name="TasksBadge" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NotesTab" Style="{StaticResource TabButton}" GroupName="PanelTabs" Checked="Tab_Checked"
                                 ToolTip="Notes (Ctrl+2)" Content="Notes" />
                </StackPanel>

                <!-- Sliding accent underline under the selected tab. -->
                <Canvas Grid.Column="0" Grid.ColumnSpan="4" IsHitTestVisible="False" ClipToBounds="False">
                    <Border x:Name="TabIndicator" Width="16" Height="3" CornerRadius="1.5" Canvas.Top="41"
                            Background="{DynamicResource AccentBrush}" />
                </Canvas>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconButton}" Checked="Pin_Changed" Unchecked="Pin_Changed" AutomationProperties.Name="Pin open">
                        <TextBlock x:Name="PinGlyph" Text="&#xE718;" FontFamily="{StaticResource IconFont}" />
                    </ToggleButton>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="Settings_Click"
                            ToolTip="Settings" Content="&#xE713;" AutomationProperties.Name="Settings" />
                    <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Click="Collapse_Click" AutomationProperties.Name="Fold into orb"
                            ToolTip="Fold into the orb (Esc)" Content="&#xE921;" />
                </StackPanel>
            </Grid>

            <!-- ============ Content ============ -->
            <Grid Grid.Row="1" x:Name="ContentArea" ClipToBounds="True">
                <v:TasksView x:Name="TasksPage" />
                <v:NotesView x:Name="NotesPage" Visibility="Collapsed" />
                <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />

                <!-- Undo toast -->
                <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12,0,12,14"
                        Padding="14,6,6,6" CornerRadius="10" Visibility="Collapsed"
                        Background="{StaticResource FlyoutBrush}" BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.4" Color="Black" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Button x:Name="ToastUndo" Style="{StaticResource TextButton}" Margin="10,0,0,0" Content="Undo" Click="ToastUndo_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

<Window x:Class="Tack.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Tack.Views"
        xmlns:c="clr-namespace:Tack.Controls"
        Title="Tack"
        Width="340" Height="480" MinWidth="280" MinHeight="200"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource BodySize}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextRenderingMode="Grayscale">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="5"
                      CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The spaces strip is a row of pills, 24 px tall and fully rounded. A space at rest sits on the theme's subtle
             fill with a hairline; the one on show is filled with the accent, its name in the accent's own text colour,
             so it never rests on colour alone (a filled shape among outlined ones). The filled layer cross-fades in
             and settles from a touch smaller when the space changes (PanelWindow.SettlePill), if Windows animates. -->
        <Style x:Key="PillFocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" CornerRadius="15" BorderThickness="1.5" BorderBrush="{DynamicResource AccentBorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpaceTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusRing}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" MaxWidth="96" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="12" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                    Background="{DynamicResource SubtleFillBrush}" BorderBrush="{DynamicResource StrokeBrush}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="Sel" CornerRadius="12" BorderThickness="1" Padding="{TemplateBinding Padding}" Opacity="0"
                                    Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                    TextElement.Foreground="{DynamicResource OnAccentTextBrush}" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StrokeBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Sel" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The strip's buttons (+, More spaces...) as pills of the same kind. -->
        <Style x:Key="SpaceButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource SubtleFillBrush}" BorderBrush="{DynamicResource StrokeBrush}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StrokeBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The strip's inline name entry for a new space. Placeholder text comes from Tag. -->
        <Style x:Key="StripNameBox" TargetType="TextBox" BasedOn="{StaticResource GhostTextBox}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="12" BorderThickness="1" Background="{DynamicResource ControlFillFocusBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}"
                                           Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Search's box in the header (Ctrl+F): a magnifier, the placeholder from Tag, room on the right for the
             count once there is one (CountChanged), so the placeholder has the room until then. -->
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource GhostTextBox}">
            <Setter Property="Padding" Value="30,0,12,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="MaxLength" Value="1000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" Background="{DynamicResource ControlFillFocusBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}">
                            <Grid>
                                <TextBlock x:Name="Glass" Text="&#xE721;" Style="{StaticResource Glyph}" HorizontalAlignment="Left" Margin="10,1,0,0"
                                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}"
                                           Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter TargetName="Glass" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Grid x:Name="Root">
        <!-- Tint over the acrylic (or a solid surface when glass is off). -->
        <Border x:Name="Surface" Background="{DynamicResource GlassTintBrush}" />

        <Grid x:Name="Chrome">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Header (also the drag handle) ============ -->
            <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand mark: a tiny version of the orb. -->
                <Grid Width="18" Height="18" Margin="16,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse Stroke="{DynamicResource BrandTrackBrush}" StrokeThickness="1.8" />
                    <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 9,0.9 A 8.1,8.1 0 1 1 1.3,11.5" />
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" />
                </Grid>

                <StackPanel x:Name="Tabs" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TasksTab" Style="{StaticResource TabButton}" GroupName="PanelTabs" Checked="Tab_Checked"
                                 ToolTip="Tasks (Ctrl+1)" AutomationProperties.Name="Tasks">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tasks" />
                            <TextBlock x:Name="TasksBadge" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NotesTab" Style="{StaticResource TabButton}" GroupName="PanelTabs" Checked="Tab_Checked"
                                 ToolTip="Notes (Ctrl+2)" Content="Notes" />
                </StackPanel>

                <!-- Search (Ctrl+F): over the tabs while it's open, so nothing else moves; not there at all until then. -->
                <Grid x:Name="SearchBar" Grid.Column="1" Grid.ColumnSpan="2" Height="32" Margin="0,0,6,0" VerticalAlignment="Center"
                      Visibility="Collapsed">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Search tasks and notes"
                             AutomationProperties.Name="Search tasks and notes"
                             AutomationProperties.HelpText="Up and Down choose a result, Enter opens it, Escape closes search"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock x:Name="SearchCount" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                               Style="{StaticResource Caption}" IsHitTestVisible="False" />
                </Grid>

                <!-- Sliding accent underline under the selected tab. -->
                <Canvas Grid.Column="0" Grid.ColumnSpan="4" IsHitTestVisible="False" ClipToBounds="False">
                    <Border x:Name="TabIndicator" Width="16" Height="3" CornerRadius="1.5" Canvas.Top="41"
                            Background="{DynamicResource AccentBrush}" />
                </Canvas>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconButton}" Checked="Pin_Changed" Unchecked="Pin_Changed" AutomationProperties.Name="Pin open">
                        <TextBlock x:Name="PinGlyph" Text="&#xE718;" FontFamily="{StaticResource IconFont}" />
                    </ToggleButton>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="Settings_Click"
                            ToolTip="Settings" Content="&#xE713;" AutomationProperties.Name="Settings" />
                    <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Click="Collapse_Click" AutomationProperties.Name="Fold into orb"
                            ToolTip="Fold into the orb (Esc)" Content="&#xE921;" />
                </StackPanel>
            </Grid>

            <!-- ============ Spaces strip: only once a second space exists ============ -->
            <!-- A row of pills that scrolls sideways (the wheel too) and fades at an edge with more beyond it;
                 + stays in sight at the end. Room around the pills for their focus rings, which the scroller clips. -->
            <Grid x:Name="Strip" Grid.Row="1" Height="32" Margin="13,0,13,4" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="StripScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                              PreviewMouseWheel="StripScroller_PreviewMouseWheel" ScrollChanged="StripScroller_ScrollChanged">
                    <c:GroupPanel x:Name="StripTabs" Orientation="Horizontal" Margin="3,0" AutomationProperties.Name="Spaces"
                                  KeyboardNavigation.DirectionalNavigation="None"
                                  PreviewKeyDown="StripTabs_PreviewKeyDown" />
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,3,0">
                    <Button x:Name="NewSpaceButton" Style="{StaticResource SpaceButton}" Width="24" Padding="0" Margin="3,0,0,0"
                            FontFamily="{StaticResource IconFont}" FontWeight="Normal" FontSize="10"
                            Content="&#xE710;" Click="NewSpace_Click" ToolTip="New space" AutomationProperties.Name="New space" />
                    <TextBox x:Name="NewSpaceBox" Style="{StaticResource StripNameBox}" Width="128" Height="24" Margin="3,0,0,0"
                             Tag="Name, then Enter" Visibility="Collapsed" AutomationProperties.Name="New space name"
                             PreviewKeyDown="NewSpaceBox_PreviewKeyDown" LostKeyboardFocus="NewSpaceBox_LostKeyboardFocus" />
                </StackPanel>
            </Grid>

            <!-- ============ Content ============ -->
            <Grid Grid.Row="2" x:Name="ContentArea" ClipToBounds="True">
                <v:TasksView x:Name="TasksPage" />
                <v:NotesView x:Name="NotesPage" Visibility="Collapsed" />
                <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
                <v:SearchView x:Name="SearchPage" Visibility="Collapsed" />

                <!-- Undo toast. While it slides and fades, a picture of it (shadow and all) stands in for it:
                     software rendering would blur the shadow anew every frame. The host leaves room above the
                     toast for its shadow, which the picture takes in. -->
                <Grid x:Name="ToastHost" VerticalAlignment="Bottom">
                    <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12,16,12,14"
                            Padding="14,6,6,6" CornerRadius="10" Visibility="Collapsed"
                            Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.4" Color="Black" />
                        </Border.Effect>
                        <!-- Undo first, so it keeps its room: a message too long for the panel ends in an ellipsis instead. -->
                        <DockPanel>
                            <Button x:Name="ToastUndo" DockPanel.Dock="Right" Style="{StaticResource TextButton}" Margin="10,0,0,0" Content="Undo" Click="ToastUndo_Click" />
                            <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <Image x:Name="ToastPicture" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                           IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
    <!-- Fade when idle: the panel as the screen showed it a moment before (frosted glass and all), fading
         away over the faded panel, so the fade starts from what was there. Only while it fades. -->
    <Image x:Name="FadePicture" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Window>
